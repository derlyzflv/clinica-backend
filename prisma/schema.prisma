generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model appointments {
  id               Int                @id @default(autoincrement())
  patient_id       Int
  doctor_id        Int
  created_by       Int
  appointment_date DateTime           @db.Date
  appointment_time DateTime           @db.Time(6)
  status           appointment_status @default(PROGRAMADA)
  doctors          doctors            @relation(fields: [doctor_id], references: [id], onUpdate: NoAction, map: "fk_appointment_doctor")
  patients         patients           @relation(fields: [patient_id], references: [id], onUpdate: NoAction, map: "fk_appointment_patient")
  users            users              @relation(fields: [created_by], references: [id], onUpdate: NoAction, map: "fk_appointment_user")

  @@unique([doctor_id, appointment_date, appointment_time], map: "idx_appointments_doctor_date_time", where: raw("(status <> 'CANCELADA'::appointment_status)"))
}

model doctors {
  id           Int            @id @default(autoincrement())
  user_id      Int            @unique
  specialty_id Int
  appointments appointments[]
  specialties  specialties    @relation(fields: [specialty_id], references: [id], onUpdate: NoAction, map: "fk_doctor_specialty")
  users        users          @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "fk_doctor_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model patients {
  id           Int            @id @default(autoincrement())
  first_name   String         @db.VarChar(100)
  last_name    String         @db.VarChar(100)
  email        String         @unique @db.VarChar(255)
  birth_date   DateTime       @db.Date
  appointments appointments[]
}

model specialties {
  id      Int       @id @default(autoincrement())
  name    String    @unique @db.VarChar(100)
  doctors doctors[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model users {
  id           Int            @id @default(autoincrement())
  name         String         @db.VarChar(100)
  email        String         @unique @db.VarChar(255)
  password     String         @db.VarChar(255)
  role         user_role      @default(RECEPCIONISTA)
  appointments appointments[]
  doctors      doctors?
}

enum appointment_status {
  PROGRAMADA
  COMPLETADA
  CANCELADA
}

enum user_role {
  RECEPCIONISTA
  MEDICO
  GERENCIA
}
